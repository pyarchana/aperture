# --- Solari SDK ---------------------------------------------------------
# Shared credential for @solarisdk/browser, @solarisdk/sandbox and
# @solarisdk/desktop. Without it, web capture degrades to a plain fetch()
# and sandbox/desktop capture fails.
SOLARI_API_KEY=

# Gateway base URL, required by the sandbox and desktop clients.
SOLARI_BASE_URL=https://api.getsolari.com

# --- Change analysis ----------------------------------------------------
# Anthropic API key. src/ai/analyzer.ts is written against the Claude API
# (@anthropic-ai/sdk). If you would rather run the analyzer on OpenAI,
# swap the implementation in that file and use OPENAI_API_KEY instead.
CLAUDE_API_KEY=
# OPENAI_API_KEY=

# Overrides the default model (claude-opus-5).
# ANALYZER_MODEL=claude-opus-5

# --- Server -------------------------------------------------------------
PORT=3000

# --- Storage ------------------------------------------------------------
# SQLite file and the directory where page/screenshot artifacts are written.
DATABASE_PATH=./aperture.db
SNAPSHOT_DIR=./snapshots

# --- Scheduler ----------------------------------------------------------
# Cron expression used for competitors that do not define their own.
DEFAULT_CRON=0 */6 * * *
# IANA timezone the cron expressions are evaluated in.
TZ=UTC
