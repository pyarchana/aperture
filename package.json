  "private": true,
  "description": "Competitive intelligence monitoring: capture competitor surfaces on a schedule, diff them, and raise analyzed alerts.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
